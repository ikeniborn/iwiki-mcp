diff --git a/src/iwiki_mcp/postgres/migrations.py b/src/iwiki_mcp/postgres/migrations.py
index 402f66d..0e47f46 100644
--- a/src/iwiki_mcp/postgres/migrations.py
+++ b/src/iwiki_mcp/postgres/migrations.py
@@ -320,6 +320,31 @@ def _validate_metadata(cursor, settings: MigrationSettings) -> None:
         raise MigrationError("embedding metadata mismatch")
 
 
+def require_schema_version(
+    dsn: str,
+    expected_version: int = 4,
+    *,
+    connect_timeout_s: int = 10,
+) -> None:
+    """Require one exact installed schema version without mutating the database."""
+    try:
+        with psycopg.connect(dsn, connect_timeout=connect_timeout_s) as connection:
+            with connection.cursor() as cursor:
+                cursor.execute("SET TRANSACTION READ ONLY")
+                cursor.execute(
+                    "SELECT COALESCE(MAX(version), 0) FROM iwiki.schema_migrations"
+                )
+                current = cursor.fetchone()[0]
+    except psycopg.Error as exc:
+        raise MigrationError(
+            f"PostgreSQL schema version {expected_version} is required"
+        ) from exc
+    if current != expected_version:
+        raise MigrationError(
+            f"PostgreSQL schema version {expected_version} is required"
+        )
+
+
