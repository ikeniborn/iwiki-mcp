worker_processes auto;
pid /run/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    access_log off;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;
    client_max_body_size 16m;

    server {
        listen 192.168.68.123:8766;

        location / {
            proxy_pass http://127.0.0.1:8765;
            proxy_http_version 1.1;
            proxy_set_header Authorization $http_authorization;
            proxy_set_header Host $host;
            proxy_buffering off;
            proxy_request_buffering off;
            # Hosted MCP answers with JSON, so no stream is held open and this
            # timeout only bounds one request. A code-graph publication or index
            # runs for minutes, and 300s turned those into a 504 the client
            # could only report as a masked transport failure.
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            # Fail fast while the MCP process is restarting instead of holding
            # the client in a connect that cannot succeed.
            proxy_connect_timeout 3s;
        }
    }
}
